{
  "name": "cloudpix-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A photo archive on a draggable 3D sphere. Browse, sort and publish frames with in-browser effects.",
  "author": "Bogdan Trotsenko <https://github.com/murpiano>",
  "license": "MIT",
  "homepage": "https://murpiano.github.io/cloudpix-platform/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/murpiano/cloudpix-platform.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "sass": "^1.105.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
